# Configuración para Tether WDK CLI (Sepolia Testnet)
WDK_NETWORK=sepolia
WDK_SEED_PHRASE=tu_seed_phrase_de_12_palabras_aqui
WDK_PASSPHRASE=tu_password_aqui

# Opciones de Paymaster & Bundler (Pimlico / Candide)
